# Core app & Security
# Supabase Staff session (browser-safe URL + publishable/anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STAFF_PROFILE_TABLE=staff_profiles

OWNER_PUBLISH_PIN=

# Meta Webhook (Omnichannel Ingress & Security)
# Keep n8n authoritative until an approved cutover; use standalone only after
# Meta is repointed and the durable Supabase adapter is available.
META_WEBHOOK_INGRESS_MODE=n8n
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# WhatsApp Cloud API (Automated Reply & Messaging)
# Keep true until the owner explicitly approves a live send cutover.
WHATSAPP_SEND_DRY_RUN=true
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Facebook Messenger (Automated Reply & Messaging)
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=1164107840123575

# Instagram Direct Messaging
INSTAGRAM_MESSAGING_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=17841439747493221

# Facebook & Instagram Social Feed Publishing
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=1164107840123575
INSTAGRAM_ACCESS_TOKEN=

# Canva OAuth (Currently Paused)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=
CANVA_REDIRECT_URI=http://localhost:3000/api/canva?action=callback

# AI providers (Coach Brain)
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
LOVABLE_API_KEY=
