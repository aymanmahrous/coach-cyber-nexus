# Core app
# Owner PIN (min 8 chars): authorizes publishing and unlocks the owner session
# (cloud post sync, WhatsApp inbox, Canva connect). Changing it signs out all sessions.
OWNER_PUBLISH_PIN=

# Durable storage (Supabase, server-only). Run supabase/migrations/*.sql first.
# Without these the app falls back to per-instance memory and reports "limited".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook / Instagram publish integration
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=1164107840123575
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=17841439747493221
META_GRAPH_VERSION=v21.0

# WhatsApp Cloud API
# Webhook URL to register in Meta: https://<your-domain>/api/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Canva OAuth
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=
CANVA_REDIRECT_URI=http://localhost:3000/api/canva?action=callback

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
LOVABLE_API_KEY=
